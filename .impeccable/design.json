  "components": [
    {
      "name": "Shift Highlighter",
      "kind": "custom",
      "refersTo": "shift-marker-a",
      "description": "Signature: the shift letter in ink on its own irregular marker stroke, at every scale.",
      "html": "<span class=\"ds-mk ds-a\">א׳</span> <span class=\"ds-mk ds-b\">ב׳</span> <span class=\"ds-mk ds-c\">ג׳</span> <span class=\"ds-mk ds-c ds-hero\">ג</span>",
      "css": ".ds-mk{position:relative;isolation:isolate;display:inline-grid;place-items:center;min-width:30px;height:26px;padding:0 8px;margin:0 6px;font-family:var(--font);font-size:13px;font-weight:800;color:var(--mk-ink)} .ds-mk::before{content:'';position:absolute;inset:0 -4px;z-index:-1;background:var(--mk);-webkit-mask:var(--stroke) 0 0/100% 100% no-repeat;mask:var(--stroke) 0 0/100% 100% no-repeat} .ds-a{--mk:var(--mk-a);--stroke:var(--stroke-a)} .ds-b{--mk:var(--mk-b);--stroke:var(--stroke-b)} .ds-c{--mk:var(--mk-c);--stroke:var(--stroke-c)} .ds-hero{width:96px;height:112px;font-size:56px;font-weight:900;line-height:1} .ds-hero::before{inset:6px -18px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The pen: the single filled action per context.",
      "html": "<button class=\"ds-btn-primary\">אישור והחלה</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:0 16px;border-radius:var(--r-sm);border:1px solid transparent;background:var(--olive);color:var(--on-acc);font-family:var(--font);font-size:13px;font-weight:700;cursor:pointer;transition:background .15s,transform .16s var(--ease-out)} .ds-btn-primary:hover{background:var(--olive-2)} .ds-btn-primary:focus-visible{outline:2px solid var(--olive);outline-offset:2px} .ds-btn-primary:active{transform:scale(.97)}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Default secondary action: a white sheet with a strong hairline.",
      "html": "<button class=\"ds-btn-ghost\">ייצוא</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:0 16px;border-radius:var(--r-sm);border:1px solid var(--border2);background:var(--s1);color:var(--text);font-family:var(--font);font-size:13px;font-weight:700;cursor:pointer;transition:background .15s,transform .16s var(--ease-out)} .ds-btn-ghost:hover{background:var(--s3)} .ds-btn-ghost:focus-visible{outline:2px solid var(--olive);outline-offset:2px} .ds-btn-ghost:active{transform:scale(.97)}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "White sheet field, strong hairline, pen-tinted focus halo.",
      "html": "<input class=\"ds-inp\" dir=\"rtl\" placeholder=\"קוד הצטרפות\">",
      "css": ".ds-inp{width:100%;height:44px;padding:0 13px;border-radius:var(--r-sm);background:var(--s1);border:1px solid var(--border2);color:var(--text);caret-color:var(--olive);font-family:var(--font);font-size:14px} .ds-inp::placeholder{color:var(--dim)} .ds-inp:focus{outline:none;border-color:var(--olive-border);box-shadow:0 0 0 3px rgba(var(--olive-rgb),.15)}"
    },
    {
      "name": "Nav Rail",
      "kind": "nav",
      "refersTo": "nav-rail",
      "description": "Desktop dark-ink rail; active item gets the yellow tick and icon.",
      "html": "<nav class=\"ds-rail\" dir=\"rtl\"><a class=\"ds-rail-i\">סקירה</a><a class=\"ds-rail-i ds-on\">סידור שנתי</a><a class=\"ds-rail-i\">אימונים</a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:3px;width:240px;padding:12px;background:var(--rail);font-family:var(--font)} .ds-rail-i{position:relative;display:flex;align-items:center;padding:11px 12px;border-radius:var(--r-sm);font-size:14px;font-weight:600;color:var(--rail-mut);cursor:pointer;transition:background .15s,color .15s} .ds-rail-i:hover{background:var(--rail-2);color:var(--rail-tx)} .ds-rail-i:focus-visible{outline:2px solid var(--olive);outline-offset:2px} .ds-rail-i.ds-on{background:var(--rail-2);color:var(--rail-tx)} .ds-rail-i.ds-on::before{content:'';position:absolute;inset-inline-start:-12px;top:22%;bottom:22%;width:4px;border-radius:3px;background:var(--rail-acc)}"
    },
    {
      "name": "Card (sheet)",
      "kind": "card",
      "refersTo": "card",
      "description": "A printed sheet on the wall: hairline, 11px, contact shadow, plain ink head.",
      "html": "<div class=\"ds-card\" dir=\"rtl\"><h3>החג הקרוב</h3><p>סיגד · 9.11.2026 · בעוד 4 ימים</p></div>",
      "css": ".ds-card{background:var(--s1);border:1px solid var(--border);border-radius:var(--r-lg);padding:16px;box-shadow:0 1px 2px rgba(17,24,39,.06);font-family:var(--font);color:var(--text);transition:box-shadow .15s,border-color .15s} .ds-card:hover{border-color:var(--border2);box-shadow:0 4px 14px rgba(17,24,39,.08)} .ds-card h3{margin:0 0 14px;font-size:13.5px;font-weight:800} .ds-card p{margin:0;font-size:12px;color:var(--muted)}"
    },
    {
      "name": "Year Grid Cells",
      "kind": "custom",
      "refersTo": "shift-marker-b",
      "description": "Frame vocabulary over the marker: plain, weekend, holiday, today, training, draft change.",
      "html": "<div class=\"ds-yg\" dir=\"rtl\"><span class=\"ds-ys\" style=\"--mk:var(--mk-a)\">א</span><span class=\"ds-ys ds-we\" style=\"--mk:var(--mk-b)\">ב</span><span class=\"ds-ys ds-hl\" style=\"--mk:var(--mk-c)\">ג</span><span class=\"ds-ys ds-td\" style=\"--mk:var(--mk-a)\">א</span><span class=\"ds-ys ds-tr\" style=\"--mk:var(--mk-b)\">ב</span><span class=\"ds-ys ds-chg\" style=\"--mk:var(--mk-c)\">ג</span></div>",
      "css": ".ds-yg{display:flex;gap:2px;padding:8px;background:var(--s1);border:1px solid var(--border);border-radius:var(--r-md)} .ds-ys{display:grid;place-items:center;width:24px;height:15px;background:var(--mk);color:var(--mk-ink);font-family:var(--font);font-size:11px;font-weight:700;cursor:pointer} .ds-ys:hover{outline:2px solid var(--olive);outline-offset:-2px} .ds-hl{box-shadow:inset 0 0 0 2px var(--hol)} .ds-td{box-shadow:inset 0 0 0 2px var(--text),inset 0 0 0 3px var(--s1)} .ds-tr{box-shadow:inset 0 0 0 2px var(--indigo)} .ds-chg{box-shadow:inset 0 -3px 0 var(--text)}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segmented-option-on",
      "description": "Equal options on a sheet; the active one is filled with the pen.",
      "html": "<div class=\"ds-seg\" dir=\"rtl\"><button class=\"ds-seg-b ds-on\">יום</button><button class=\"ds-seg-b\">לילה</button><button class=\"ds-seg-b\">אוטומטי</button></div>",
      "css": ".ds-seg{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:4px;border-radius:var(--r-md);background:var(--s1);border:1px solid var(--border)} .ds-seg-b{min-height:42px;border:0;border-radius:10px;background:none;font-family:var(--font);font-size:13px;font-weight:700;color:var(--muted);cursor:pointer;transition:background .15s,color .15s} .ds-seg-b:hover{color:var(--text)} .ds-seg-b:focus-visible{outline:2px solid var(--olive);outline-offset:2px} .ds-seg-b.ds-on{background:var(--olive);color:var(--on-acc)}"
    },
    {
      "name": "Fairness Footnote",
      "kind": "custom",
      "refersTo": "",
      "description": "Totals as a footnote line of tabular figures; only the bad value turns red.",
      "html": "<p class=\"ds-foot\" dir=\"rtl\">סה״כ 2026: <span><span class=\"ds-w\" style=\"--mk:var(--mk-a);--stroke:var(--stroke-a)\">א׳</span><b>122</b></span><span><span class=\"ds-w\" style=\"--mk:var(--mk-b);--stroke:var(--stroke-b)\">ב׳</span><b>122</b></span><span class=\"ds-bad\">פער<b>2</b></span></p>",
      "css": ".ds-foot{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 20px;margin:0;font-family:var(--font);font-size:13px;color:var(--muted)} .ds-foot b{font-size:17px;font-weight:800;color:var(--text);font-variant-numeric:tabular-nums;margin-inline-start:4px} .ds-foot .ds-bad b{color:var(--red)} .ds-w{position:relative;isolation:isolate;padding:0 .3em;font-weight:800;color:var(--mk-ink)} .ds-w::before{content:'';position:absolute;inset:-1px -3px 0;z-index:-1;background:var(--mk);-webkit-mask:var(--stroke) 0 0/100% 100% no-repeat;mask:var(--stroke) 0 0/100% 100% no-repeat}"
    },
    {
      "name": "Toast with Undo",
      "kind": "custom",
      "refersTo": "toast",
      "description": "Floating confirmation with a way back.",
      "html": "<div class=\"ds-toast\" dir=\"rtl\"><span>המשמרת ב־12.3 שונתה ל־ב׳</span><button class=\"ds-toast-a\">ביטול</button></div>",
      "css": ".ds-toast{display:inline-flex;align-items:center;gap:14px;padding:6px 6px 6px 18px;padding-inline:18px 6px;background:var(--s3);border:1px solid var(--border2);border-radius:var(--r-md);box-shadow:var(--shadow);font-family:var(--font);font-size:13px;font-weight:600;color:var(--text)} .ds-toast-a{min-height:36px;padding:0 14px;border-radius:var(--r-sm);font-family:inherit;font-weight:800;color:var(--olive-2);background:var(--olive-dim);border:1px solid var(--olive-border);cursor:pointer} .ds-toast-a:hover{background:rgba(var(--olive-rgb),.16)} .ds-toast-a:focus-visible{outline:2px solid var(--olive);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Duty Roster on the Notice Board",
    "overview": "The schedule is a printed roster: white sheets pinned to a cool light-gray wall, set in black ink, with a ballpoint-blue pen for anything the user acts on and a dark-ink rail at the inline start. The one loud material is the highlighter. Each of the three shifts owns one marker colour (א׳ yellow, ב׳ pink, ג׳ green), and every place a shift appears, from the large \"on duty now\" letter to each of the 365 cells in the year grid, the letter sits on an irregular, hand-swiped marker stroke. The data is the colour; the chrome stays paper and ink.\n\nDensity follows the printed original. The year view is a tight table of 10–11px tabular figures. The phone overview is spacious and answers \"whose shift is it\" before any reading. Calendar conventions come from a printed Hebrew calendar: holidays in red ink, weekends as a faint gray column band, today framed in black ink. Fairness numbers sit beside the roster as footnote lines, never as coloured alert tiles. The build rejects the dark command-center dashboard it replaced: no glows, background grids, radial spotlights or corner brackets.\n\nThe world ships in two themes. \"יום\" (board, default, light) is the canonical sheet. \"לילה\" (night) is the same board in light ink on dark sheets, and the highlighters stay.",
    "keyCharacteristics": [
      "Three fixed highlighter colours own the shifts, and the letter is always printed on the marker.",
      "Paper-and-ink chrome: white sheets, hairline rules, small radii, one ballpoint-blue accent.",
      "Calendar marks are drawn as ink frames and underlines on top of the marker, never as replacement fills.",
      "RTL Hebrew throughout. One family (Heebo) carries every role, with tabular figures for every number.",
      "Flat print: one barely-there sheet shadow, and real elevation only for floating layers."
    ],
    "rules": [
      {
        "name": "The Highlighter Monopoly Rule",
        "body": "Yellow, pink and green belong to shifts א׳, ב׳ and ג׳ and to nothing else. Never use them for status, categories, charts or decoration. The only allowed reuse is the app mark and the rail's tick and pip, which are the roster's own pen.",
        "section": "colors"
      },
      {
        "name": "The Letter-On-Marker Rule",
        "body": "A shift colour never appears without its letter printed on it in ink (#161b22). Colour is the fast read and the letter is the accessible one.",
        "section": "colors"
      },
      {
        "name": "The One Pen Rule",
        "body": "Ballpoint blue is the only accent for action and selection. Status colours mark text and thin frames, never buttons or large fills.",
        "section": "colors"
      },
      {
        "name": "The Ten-Pixel Floor Rule",
        "body": "No text is set below 10px. The year grid is the densest surface and stops there.",
        "section": "typography"
      },
      {
        "name": "The Tabular Everywhere Rule",
        "body": "Every number (dates, counts, clock, KPIs, totals) uses tabular figures in Heebo, so columns of numbers line up like a printed table.",
        "section": "typography"
      },
      {
        "name": "The No-Glow Rule",
        "body": "Nothing emits light. No outer glows, inner glows, text shadows, pulsing dots or radial spotlights. A state is shown by an ink frame, a tone change or the pen colour.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** put every shift letter on its own highlighter stroke (א׳ #ffe14a, ב׳ #ffb2d6, ג׳ #a6e3a0) in ink #161b22, at every scale from the hero to the year grid.",
      "**Do** draw calendar state as ink frames and underlines over the marker: today 2px ink, holiday 2px red, training 2px violet, minor holiday ochre underline, draft change 3px ink underline.",
      "**Do** keep chrome paper-and-ink: white sheets on wall gray, 1px hairlines, 5–11px radii, ballpoint blue as the single action colour.",
      "**Do** write status in words and fairness as footnote lines with tabular figures, and turn only the offending number red.",
      "**Do** separate content inside a sheet with hairline rows rather than boxes inside boxes.",
      "**Do** keep holidays in red ink and weekends in the faint gray band, like a printed Hebrew calendar."
    ],
    "donts": [
      "**Don't** use glow, pulsing, text-shadow, radial spotlights, background grids or corner brackets. That is the command-center dashboard this world replaced.",
      "**Don't** use the highlighter colours for anything but the three shifts, and don't show a shift colour without its letter.",
      "**Don't** fill a holiday or weekend cell with red or gray instead of its shift marker. The marker stays and the calendar mark goes on top.",
      "**Don't** put coloured icon tiles in card heads or coloured status pills. Icons are plain ink line icons, and status is a word.",
      "**Don't** set text below 10px.",
      "**Don't** add decorative gradients. The only radial gradients in the system draw printed dots (the balance-day dot and the holiday legend dot)."
    ]
  }
}
